# Copia este archivo como ".env" y cambia los valores. El archivo ".env" NO se sube al repositorio.
RESIDENTES_DB_ROOT_PASSWORD=cambia_esto_root1
RESIDENTES_DB_PASSWORD=cambia_esto_res1
ADMIN_DB_ROOT_PASSWORD=cambia_esto_root2
ADMIN_DB_PASSWORD=cambia_esto_adm1
PROPIETARIOS_DB_ROOT_PASSWORD=cambia_esto_root3
PROPIETARIOS_DB_PASSWORD=cambia_esto_prop3

# Opcional: puerto del equipo donde se publica la API de propietarios (por defecto 3000).
PROPIETARIOS_API_PORT=3000
# Opcional: clave de Laravel. Si se deja vacía, se genera una al arrancar.
# Para obtener una fija (con los contenedores encendidos): docker compose exec admin-web php artisan key:generate --show
APP_KEY=

# Opcional: puerto del equipo donde se publica la API de residentes (por defecto 8080).
# Cámbialo si otro programa ya usa el 8080, por ejemplo: API_PORT=8081
API_PORT=8080
